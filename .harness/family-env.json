{
  "schema": 1,
  "family": "lab-management-system",
  "members": {
    "react": ["frontend"],
    "vue": ["frontend"],
    "nextjs": ["frontend", "backend"],
    "springboot": ["backend"],
    "aspnetcore": ["backend"],
    "rails": ["backend"],
    "fastapi": ["backend"],
    "kotlin": ["backend"],
    "laravel": ["backend"],
    "go": ["backend"]
  },
  "synced_keys": {
    "JWT_SIGNING_KEY": {"secret": true, "per_repo": {"nextjs": "LAB_JWT_SECRET"}},
    "JWT_ISSUER": {"per_repo": {"nextjs": "LAB_JWT_ISSUER"}},
    "JWT_AUDIENCE": {},
    "JWT_TTL_SECONDS": {"per_repo": {"nextjs": "LAB_JWT_TTL_SECONDS"}},
    "LAB_CORS_ALLOWED_ORIGINS": {"scope": ["backend"]},
    "SAAS_IDP_BASE": {
      "scope": ["nextjs", "springboot", "aspnetcore", "kotlin", "laravel"],
      "per_repo": {"springboot": "LAB_SAAS_BASE_URL", "aspnetcore": "LAB_SAAS_BASE_URL", "nextjs": "SAAS_IDP_URL",
                   "kotlin": "LAB_SAAS_BASE_URL", "laravel": "LAB_SAAS_BASE_URL"},
      "note": "2026-08-28 scope backend→nextjs: lab 各后端 SSO 走同栈匹配 (springboot→saas-springboot / aspnetcore→saas-aspnetcore / nextjs→saas-nextjs), 跨栈值本就不同,不是漂移。2026-10-26 scope 回扩全 SSO 消费后端+人裁补登 kotlin/laravel/go members: dev/test 值实测全家族统一 http://localhost:5101, prod 走各仓 .env.production 不在此比对"
    },
    "SAAS_UI_BASE": {
      "scope": ["nextjs"],
      "per_repo": {"react": "VITE_SAAS_BASE_URL", "vue": "VITE_SAAS_BASE_URL", "nextjs": "SAAS_UI_BASE_URL"},
      "note": "2026-08-29 scope 全family→nextjs: lab 前端 SSO 登录页同栈匹配 (react→saas-react / vue→saas-vue / nextjs→saas-nextjs), 跨栈值本就不同,不是漂移。react/vue 的 key 保留在 per_repo 供查值但不再跨仓比对"
    },
    "DATABASE_NAME": {"scope": ["springboot", "aspnetcore"]}
  }
}
