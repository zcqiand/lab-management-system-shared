{
  "name": "@lab/management-system-shared",
  "version": "0.1.0",
  "description": "Lab Management System — TypeSpec SSOT. Pure contract source-of-truth: TypeSpec → OpenAPI only. Language-specific clients (TS / Java / C#) are generated by each consuming project.",
  "type": "module",
  "exports": {
    ".": "./tsp/main.tsp",
    "./openapi": "./generated/openapi/openapi.yaml"
  },
  "files": [
    "tsp",
    "scripts",
    "generated",
    "tsconfig.json",
    "tspconfig.yaml"
  ],
  "scripts": {
    "build": "npm run emit:openapi",
    "emit:openapi": "tsx scripts/codegen/emit-openapi.ts",
    "lint": "tsp compile . --no-emit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.13.4",
    "@types/node": "^22.10.0",
    "@typespec/compiler": "^1.0.0",
    "@typespec/http": "^1.15.0",
    "@typespec/openapi3": "^1.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@typespec/openapi": "^1.15.0",
    "@typespec/rest": "^0.85.0"
  }
}